{
  "name": "studynotes-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Starter kit agéntico: app web en AWS Lambda Web Functions + DynamoDB, pensada para costar casi nada.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.cjs --minify --legal-comments=none",
    "start": "node dist/index.cjs",
    "bootstrap": "cdk bootstrap",
    "diff": "npm run build && cdk diff",
    "deploy": "npm run build && cdk deploy",
    "destroy": "cdk destroy"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1178.0",
    "@aws-sdk/lib-dynamodb": "^3.1178.0",
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.22"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "aws-cdk": "^2.1149.0",
    "aws-cdk-lib": "^2.278.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
